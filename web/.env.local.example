# ── Supabase ───────────────────────────────────────────────────
# Settings > API en https://supabase.com/dashboard

# URL del proyecto
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Anon key (JWT) — expuesta al browser Y usada server-side
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — SOLO en server-side, nunca exponer al cliente
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Resend (email transaccional) ───────────────────────────────
# Obtén tu API key en https://resend.com/api-keys
RESEND_API_KEY=re_...

# ── Stripe ─────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Anthropic (Eva chatbot) ─────────────────────────────────────
# Obtén tu API key en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
